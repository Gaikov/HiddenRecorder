<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>Assets/HiddenRecorder.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../HiddenRecorder.Core/HiddenRecorder.Core.csproj" />
    <ProjectReference Include="../HiddenRecorder.Infrastructure/HiddenRecorder.Infrastructure.csproj" />
    <Content Include="../../build/native/Release/HiddenRecorder.Media.dll" Link="HiddenRecorder.Media.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- WinUI implicitly includes Assets; remove duplicates and keep source artwork out of the runtime. -->
    <Content Remove="Assets/HiddenRecorder.ico;Assets/HiddenRecorder.png;Assets/README.md" />
    <Content Include="Assets/HiddenRecorder.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged dotnet publish does not automatically publish the application's merged PRI. -->
  <Target Name="PublishAppResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="Missing WinUI application resource index: $(TargetDir)$(TargetName).pri" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
